{
  "name": "moodl-v3",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "studio": "sanity dev",
    "studio:deploy": "sanity deploy",
    "studio:build": "sanity build",
    "seed": "tsx scripts/seed.ts",
    "audit:lh": "lighthouse http://localhost:4321 --quiet --chrome-flags='--headless' --output=html --output-path=./reports/lighthouse.html --only-categories=performance,accessibility,best-practices,seo",
    "audit:lh:mobile": "lighthouse http://localhost:4321 --quiet --chrome-flags='--headless' --preset=desktop --output=html --output-path=./reports/lighthouse-desktop.html --only-categories=performance,accessibility,best-practices,seo",
    "audit:axe": "axe http://localhost:4321 --tags wcag2a,wcag2aa,wcag22aa --save ./reports/axe.json",
    "audit:axe:pages": "axe http://localhost:4321 http://localhost:4321/investir http://localhost:4321/simulateur http://localhost:4321/contact http://localhost:4321/about http://localhost:4321/faq http://localhost:4321/modeles --tags wcag2a,wcag2aa --save ./reports/axe-full.json",
    "audit:all": "npm run audit:lh && npm run audit:axe:pages",
    "audit:prod": "lighthouse https://moodl.fr --quiet --chrome-flags='--headless' --output=html --output-path=./reports/lighthouse-prod.html"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.6",
    "@hookform/resolvers": "^5.2.2",
    "@portabletext/react": "^6.2.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sanity/client": "^7.22.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.24.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.1",
    "astro-portabletext": "^0.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "nodemailer": "^8.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "sanity": "^5.24.0",
    "styled-components": "^6.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.0",
    "@sentry/astro": "^8.55.0",
    "@types/nodemailer": "^8.0.0",
    "dotenv": "^17.4.2",
    "lighthouse": "^12.3.0",
    "tsx": "^4.21.0"
  }
}
