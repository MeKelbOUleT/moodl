# Sanity
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production
# Token read-only (utilisé uniquement si build SSR a besoin de drafts).
# Le seed script utilise un token write SÉPARÉ (à mettre dans .env.local, jamais committé).
SANITY_API_READ_TOKEN=

# Site
SITE_URL=https://moodl.fr

# SMTP LWS — formulaire de contact + capture lead simulateur
# LWS : smtp.lws.fr ou directement le serveur de votre hébergement mail
# Port 465 = SSL (SMTP_SECURE=true) | Port 587 = STARTTLS (SMTP_SECURE=false)
SMTP_HOST=smtp.lws.fr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=shelter@moodl.fr
SMTP_PASS=

# Destinataire des leads (reçoit les e-mails du formulaire)
LEADS_TO_EMAIL=shelter@moodl.fr

# Expéditeur affiché (doit correspondre à SMTP_USER ou alias autorisé chez LWS)
LEADS_FROM_EMAIL=shelter@moodl.fr
LEADS_FROM_NAME=Moodl Site
