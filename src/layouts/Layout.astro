---
import '@/styles/global.css';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  canonical?: string;
  noIndex?: boolean;
  bodyClass?: string;
}

const {
  title = 'Moodl - Votre cocon, en pleine nature.',
  description = "Une adresse choisie en pleine nature, dessinée pour s'y blottir. À habiter, à louer, souvent les deux. 10 à 15 % de rendement annuel quand vous n'y êtes pas.",
  ogImage,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  canonical,
  noIndex = false,
  bodyClass = '',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://moodl.fr';
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname.replace(/\/$/, '') || '/'}`;
const ogImageUrl = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`)
  : `${siteUrl}/og-default.jpg`;
const pathname = Astro.url.pathname;
const showCanonical = !noIndex;

// JSON-LD Organization (présent sur toutes les pages)
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Moodl',
  alternateName: 'Atelier Moodl',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/logo-moodl.png`,
    width: 512,
    height: 512,
  },
  image: `${siteUrl}/og-default.jpg`,
  description: 'Atelier qui conçoit des hameaux touristiques en pleine nature, terrain rare, architecture signée, intendance déléguée. À habiter, à louer, souvent les deux.',
  email: 'shelter@moodl.fr',
  telephone: '+33-7-66-87-30-40',
  founder: {
    '@type': 'Person',
    name: 'Olivier Bertrand',
    url: `${siteUrl}/about`,
  },
  foundingDate: '2024',
  foundingLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'FR',
    },
  },
  areaServed: [
    {'@type': 'Country', name: 'France'},
    {'@type': 'AdministrativeArea', name: 'Dordogne'},
    {'@type': 'AdministrativeArea', name: 'Ardèche'},
    {'@type': 'AdministrativeArea', name: 'Haute-Savoie'},
  ],
  sameAs: ['https://moodl.fr'],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'shelter@moodl.fr',
      telephone: '+33-7-66-87-30-40',
      areaServed: 'FR',
      availableLanguage: ['French'],
      hoursAvailable: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '19:00',
      },
    },
    {
      '@type': 'ContactPoint',
      contactType: 'press',
      email: 'presse@moodl.fr',
      areaServed: 'FR',
      availableLanguage: ['French'],
    },
  ],
  knowsAbout: [
    'Résidences de tourisme',
    'Hébergement insolite',
    'Investissement immobilier LMNP',
    'Architecture en pleine nature',
    'Urbanisme STECAL',
    'Conciergerie touristique',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Moodl',
  url: siteUrl,
  inLanguage: 'fr-FR',
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#090F15" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {showCanonical && <link rel="canonical" href={canonicalUrl} />}
    {showCanonical && <link rel="alternate" hreflang="fr" href={canonicalUrl} />}
    {showCanonical && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Moodl" />

    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {ogType === 'article' && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.sanity.io" />

    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap"
    />
    <link
      rel="preload"
      as="style"
      href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    {import.meta.env.PROD && !noIndex && (
      <script
        is:inline
        defer
        data-domain="moodl.fr"
        src="https://plausible.io/js/script.tagged-events.outbound-links.js"
      />
    )}
    {import.meta.env.PROD && !noIndex && (
      <script is:inline set:html={`window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)}`} />
    )}

    <slot name="head" />
  </head>

  <body class={`bg-background text-foreground min-h-screen ${bodyClass}`}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-md focus:bg-primary focus:text-primary-foreground focus:font-medium focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background"
    >
      Aller au contenu principal
    </a>
    <Navigation client:load pathname={pathname} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import {setupScrollDepth, setupCtaTracking} from '@/lib/analytics';
      setupScrollDepth();
      setupCtaTracking();
    </script>
  </body>
</html>
