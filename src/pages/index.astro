---
import Layout from '@/layouts/Layout.astro';
import {Image} from 'astro:assets';
import heroGarrigue from '@/assets/renders/hamlet-garrigue.jpg';
import StatsSection from '@/components/sections/StatsSection';
import PourQuiSection from '@/components/sections/PourQuiSection';
import WhyMoodlSection from '@/components/sections/WhyMoodlSection';
import SansMoodlSection from '@/components/sections/SansMoodlSection';
import LeHameauSection from '@/components/sections/LeHameauSection';
import ModulesBentoSection from '@/components/sections/ModulesBentoSection';
import ProgrammesSection from '@/components/sections/ProgrammesSection';
import TestimonialsSection from '@/components/sections/TestimonialsSection';
import SimulatorTeaserSection from '@/components/sections/SimulatorTeaserSection';
import FinalCTASection from '@/components/sections/FinalCTASection';
import FAQAccordion from '@/components/FAQAccordion';
import {getScarcitySnapshot} from '@/lib/scarcity';
import {getFaqSubsetFor, buildFaqPageSchema} from '@/lib/faq-helpers';

const scarcity = await getScarcitySnapshot();
const faqItems = getFaqSubsetFor('home');
const faqSchema = buildFaqPageSchema(faqItems);
---

<Layout
  title="Moodl - Votre cocon, en pleine nature."
  description="Une adresse choisie en pleine nature, dessinée pour s'y blottir. À habiter, à louer, souvent les deux. 10 à 15 % de rendement annuel quand vous n'y êtes pas."
  canonical="https://moodl.fr/"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <section class="relative min-h-screen flex items-center pt-32 pb-24 overflow-hidden">
    <!-- Image hero : Hameau Moodl en garrigue méditerranéenne -->
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
      <Image
        src={heroGarrigue}
        alt=""
        width={2400}
        height={1600}
        quality={88}
        format="webp"
        loading="eager"
        class="w-full h-full object-cover object-[center_45%] scale-105 hero-zoom"
        style="filter: saturate(1.05) contrast(1.05);"
      />
      <!-- Overlay graduel renforcé : ciel clair demande un overlay plus présent pour lisibilité H1 blanc -->
      <div class="absolute inset-0 bg-gradient-to-b from-background/70 via-background/55 to-background"></div>
      <!-- Voile lime central pour cohérence palette (subtil) -->
      <div class="absolute inset-0" style="background: radial-gradient(ellipse 70% 50% at 50% 50%, hsl(135 18% 50% / 0.06), transparent 65%);"></div>
    </div>
    <!-- Grille technique : signature architecte -->
    <div
      aria-hidden="true"
      class="absolute inset-0 pointer-events-none opacity-[0.04] text-foreground"
      style="background-image: linear-gradient(to right, currentColor 1px, transparent 1px), linear-gradient(to bottom, currentColor 1px, transparent 1px); background-size: 64px 64px;"
    ></div>

    <div class="container mx-auto px-6 lg:px-8 relative">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-xs uppercase tracking-[0.25em] text-primary font-medium mb-8 hero-fade" style="animation-delay: 0ms;">
          À habiter. À louer. Souvent les deux.
        </p>

        <h1 class="font-display text-5xl md:text-7xl lg:text-[5.5rem] font-bold leading-[1.05] tracking-tight mb-8 hero-fade" style="animation-delay: 120ms; text-shadow: 0 2px 16px rgba(9, 15, 21, 0.45);">
          Votre cocon,
          <br />
          <span class="relative inline-block">
            <span class="relative z-10 font-serif-italic text-secondary">en pleine nature.</span>
            <span aria-hidden="true" class="absolute inset-0 blur-3xl bg-primary/30 -z-10 hero-glow"></span>
          </span>
        </h1>

        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto mb-3 leading-relaxed hero-fade" style="animation-delay: 240ms;">
          Le terrain rare, le permis, les plans, l'habitat. Et l'intendance <span class="italic">si vous voulez</span>.
        </p>
        <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto mb-8 leading-relaxed hero-fade" style="animation-delay: 280ms;">
          À habiter. À louer. Jusqu'à <span class="text-foreground font-medium">15 % de rendement annuel</span> quand le hameau tourne.
        </p>
        <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground/80 font-medium mb-10 hero-fade" style="animation-delay: 320ms;">
          Programmes clé en main, 4 à 8 lots par adresse
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 hero-fade" style="animation-delay: 360ms;">
          <a
            href="/programmes"
            data-analytics-cta="hero_primary_lieux"
            class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-md bg-primary text-primary-foreground font-medium shadow-lg hover:shadow-[0_0_30px_rgba(106,142,114,0.45)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-reduce:transition-none motion-reduce:hover:scale-100"
          >
            Voir les lieux Moodl
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="/simulateur"
            data-analytics-cta="hero_secondary_simulateur"
            class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-md border border-border bg-transparent text-foreground font-medium hover:bg-accent hover:text-accent-foreground hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-reduce:transition-none motion-reduce:hover:scale-100"
          >
            Simuler ma rentabilité
          </a>
        </div>
      </div>
    </div>

    <div
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 h-32 pointer-events-none"
      style="background: linear-gradient(to top, hsl(210 29% 12% / 0.4), transparent);"
    ></div>
  </section>

  <PourQuiSection client:visible />
  <StatsSection client:visible scarcity={scarcity} />
  <SansMoodlSection />
  <WhyMoodlSection />
  <LeHameauSection />
  <ModulesBentoSection client:visible />
  <ProgrammesSection client:visible />
  <TestimonialsSection client:visible />
  <SimulatorTeaserSection client:visible />

  <section class="py-24 lg:py-32 bg-background border-t border-border/60">
    <div class="container mx-auto px-6 lg:px-8 max-w-4xl">
      <div class="mb-12">
        <p class="text-xs uppercase tracking-[0.25em] text-primary font-medium mb-5">
          Vous vous demandez ?
        </p>
        <h2 class="font-display text-4xl lg:text-5xl font-bold leading-tight tracking-tight">
          Cinq questions, <span class="font-serif-italic text-secondary">cinq réponses claires</span>.
        </h2>
      </div>
      <FAQAccordion client:visible items={faqItems} context="home" />
      <p class="text-sm text-muted-foreground italic mt-8">
        Dix-sept questions supplémentaires sur <a href="/faq" class="text-primary underline underline-offset-2 decoration-1 hover:decoration-2">la page FAQ complète</a>.
      </p>
    </div>
  </section>

  <FinalCTASection client:visible scarcity={scarcity} />
</Layout>

<style>
  .hero-fade {
    opacity: 0;
    transform: translateY(30px);
    animation: heroReveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes heroReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .hero-glow {
    animation: heroGlow 4.5s ease-in-out infinite;
  }
  @keyframes heroGlow {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.7; }
  }
  .hero-zoom {
    animation: heroZoom 18s ease-in-out infinite alternate;
  }
  @keyframes heroZoom {
    0% { transform: scale(1.05); }
    100% { transform: scale(1.12); }
  }
</style>
