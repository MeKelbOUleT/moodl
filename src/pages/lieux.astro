---
import Layout from '@/layouts/Layout.astro';
import {sanityClient, urlFor} from '@/sanity/client';
import {lieuxAllQuery} from '@/sanity/queries';

let lieux: any[] = [];
try {
  lieux = await sanityClient.fetch(lieuxAllQuery);
} catch (e) {
  console.warn('Sanity non disponible, page /lieux vide.', e);
}

const formatEuro = (n: number) =>
  new Intl.NumberFormat('fr-FR', {style: 'currency', currency: 'EUR', maximumFractionDigits: 0}).format(n);

const surfaceLabel = (min?: number, max?: number) => {
  if (min && max && min !== max) return `${min} à ${max} m²`;
  if (max) return `${max} m²`;
  if (min) return `${min} m²`;
  return '-';
};
---

<Layout
  title="Habitats Moodl : Circle, Love Boat, Nova, A-Frame, Nebula"
  description="Cinq formes pour cinq usages. Circle, Love Boat, Nova, A-Frame, Nebula. Capsules signées atelier français."
>
  <section class="relative pt-40 pb-20 overflow-hidden">
    <div
      aria-hidden="true"
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 70% 50% at 50% 30%, hsl(135 18% 50% / 0.07), transparent 60%);"
    ></div>
    <div class="container mx-auto px-6 lg:px-8 text-center max-w-3xl relative">
      <p class="text-xs uppercase tracking-[0.25em] text-primary font-medium mb-6">
        Les habitats
      </p>
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] tracking-tight mb-6">
        Cinq formes pour<br />
        <span class="font-serif-italic text-secondary">cinq usages</span>.
      </h1>
      <p class="text-lg text-muted-foreground leading-relaxed">
        Chaque habitat est dessiné pour dialoguer avec son terrain. Surface, matière, orientation, lumière - tout est pensé pour qu'on s'y blottisse.
      </p>
    </div>
  </section>

  {lieux.length === 0 ? (
    <section class="py-16 lg:py-20">
      <div class="container mx-auto px-6 lg:px-8 max-w-3xl text-center">
        <div class="bg-card border border-dashed border-border/60 rounded-2xl p-10 lg:p-14">
          <p class="font-display text-2xl lg:text-3xl text-muted-foreground mb-4">
            Catalogue d'habitats bientôt visible.
          </p>
          <p class="text-muted-foreground leading-relaxed max-w-xl mx-auto">
            L'atelier finalise les fiches techniques de chaque habitat - surface, capacité, prestations, rendement indicatif.
          </p>
        </div>
      </div>
    </section>
  ) : (
    lieux.map((lieu: any, i: number) => {
      const reverse = i % 2 === 1;
      const heroUrl = lieu.hero_image ? urlFor(lieu.hero_image).width(1200).height(900).url() : null;
      return (
        <section id={lieu.slug} class="py-20 lg:py-28 border-b border-border/50 last:border-b-0 scroll-mt-24">
          <div class="container mx-auto px-6 lg:px-8">
            <div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center ${reverse ? 'lg:grid-flow-col-dense' : ''}`}>
              <div class={`lg:col-span-7 ${reverse ? 'lg:col-start-6' : ''}`}>
                <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-muted">
                  {heroUrl ? (
                    <img src={heroUrl} alt={lieu.name} class="w-full h-full object-cover" loading="lazy" />
                  ) : (
                    <div class="w-full h-full bg-gradient-to-br from-primary/15 via-secondary/10 to-background flex items-center justify-center">
                      <span class="font-display text-6xl text-foreground/30">{lieu.name?.charAt(0)}</span>
                    </div>
                  )}
                </div>
              </div>

              <div class={`lg:col-span-5 ${reverse ? 'lg:col-start-1 lg:row-start-1' : ''}`}>
                {lieu.subtitle && (
                  <p class="text-xs uppercase tracking-[0.2em] text-primary font-medium mb-4">
                    {lieu.subtitle}
                  </p>
                )}
                <h2 class="font-display text-4xl lg:text-5xl font-bold tracking-tight leading-[1.05] mb-4">
                  {lieu.name}
                </h2>
                {lieu.tagline && (
                  <p class="font-serif-italic text-xl text-secondary mb-6">{lieu.tagline}</p>
                )}

                <dl class="grid grid-cols-2 gap-x-6 gap-y-5 mt-6 mb-8 pb-8 border-b border-border/50">
                  <div>
                    <dt class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Surface</dt>
                    <dd class="font-medium">{surfaceLabel(lieu.surface_min_m2, lieu.surface_max_m2)}</dd>
                  </div>
                  {lieu.capacite && (
                    <div>
                      <dt class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Capacité</dt>
                      <dd class="font-medium">{lieu.capacite}</dd>
                    </div>
                  )}
                  {lieu.loyer_nuit_indicatif && (
                    <div>
                      <dt class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Loyer indicatif</dt>
                      <dd class="font-medium">{lieu.loyer_nuit_indicatif} € / nuit</dd>
                    </div>
                  )}
                  {lieu.prix_a_partir_de && (
                    <div>
                      <dt class="text-xs uppercase tracking-widest text-muted-foreground mb-1">À partir de</dt>
                      <dd class="font-medium">{formatEuro(lieu.prix_a_partir_de)}</dd>
                    </div>
                  )}
                </dl>

                {lieu.roi_indicatif && (
                  <div class="mb-8">
                    <p class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Rendement indicatif</p>
                    <p class="font-display text-4xl font-bold text-primary">{lieu.roi_indicatif}</p>
                  </div>
                )}

                <div class="flex flex-col sm:flex-row gap-3">
                  <a href={`/lieux/${lieu.slug}`} class="flex-1 inline-flex items-center justify-center h-12 px-6 rounded-md bg-primary text-primary-foreground font-medium shadow-lg hover:shadow-[0_0_30px_rgba(106,142,114,0.4)] hover:scale-[1.01] transition-all duration-300">
                    Découvrir {lieu.name}
                  </a>
                  <a href="/simulateur" class="inline-flex items-center justify-center h-12 px-6 rounded-md border border-border bg-transparent text-foreground font-medium hover:bg-accent hover:text-accent-foreground hover:scale-[1.01] transition-all">
                    Simuler
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
      );
    })
  )}
</Layout>
