---
import Layout from '@/layouts/Layout.astro';
import {sanityClient, urlFor} from '@/sanity/client';
import {programmesAllQuery} from '@/sanity/queries';

let programmes: any[] = [];
try {
  programmes = await sanityClient.fetch(programmesAllQuery);
} catch (e) {
  console.warn('Sanity non disponible, page /programmes vide.', e);
}

const formatEuro = (n: number) =>
  new Intl.NumberFormat('fr-FR', {style: 'currency', currency: 'EUR', maximumFractionDigits: 0}).format(n);

const rendementLabel = (min?: number, max?: number) => {
  if (min && max && min !== max) return `${min} - ${max} %`;
  if (max) return `${max} %`;
  if (min) return `${min} %`;
  return '-';
};
---

<Layout
  title="Programmes Moodl : adresses Dordogne, Ardèche, Annecy"
  description="Adresses choisies en pleine nature : Dordogne, Ardèche, Lac d'Annecy. Lots disponibles, rendement visé, date de livraison."
>
  <section class="relative pt-40 pb-16 lg:pb-20 overflow-hidden">
    <div
      aria-hidden="true"
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 70% 50% at 50% 30%, hsl(150 100% 50% / 0.07), transparent 60%);"
    ></div>
    <div class="container mx-auto px-6 lg:px-8 text-center max-w-3xl relative">
      <p class="text-xs uppercase tracking-[0.25em] text-primary font-medium mb-6">
        Nos adresses
      </p>
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] tracking-tight mb-6">
        Des adresses<br />
        <span class="font-serif-italic text-secondary">à demeure</span>.
      </h1>
      <p class="text-lg text-muted-foreground leading-relaxed">
        Sélectionnées une à une - vue, accès, voisinage, environnement. La rareté est dans l'endroit, jamais reproduit ailleurs.
      </p>
    </div>
  </section>

  <section class="py-12 lg:py-20">
    <div class="container mx-auto px-6 lg:px-8">
      {programmes.length === 0 ? (
        <div class="max-w-2xl mx-auto bg-card border border-dashed border-border/60 rounded-2xl p-10 lg:p-14 text-center">
          <p class="font-display text-2xl lg:text-3xl text-muted-foreground mb-4">
            Premières adresses bientôt en ligne.
          </p>
          <p class="text-muted-foreground leading-relaxed max-w-xl mx-auto mb-8">
            Inscrivez-vous pour recevoir en priorité les nouvelles adresses Moodl avant leur ouverture publique.
          </p>
          <a href="/contact" class="inline-flex items-center justify-center gap-2 h-11 px-6 rounded-md bg-primary text-primary-foreground font-medium text-sm shadow-md hover:shadow-[0_0_30px_rgba(0,255,128,0.35)] hover:scale-[1.01] active:scale-[0.99] transition-all duration-300">
            Être informé en avant-première
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-7xl mx-auto">
          {programmes.map((p: any) => {
            const remaining = p.lots_disponibles ?? 0;
            const total = p.lots_total ?? 0;
            const progress = total > 0 ? ((total - remaining) / total) * 100 : 0;
            const heroUrl = p.hero_image ? urlFor(p.hero_image).width(900).height(675).url() : null;
            return (
              <a href={`/programmes/${p.slug}`} class="group bg-card border border-border/60 hover:border-primary/40 rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl flex flex-col">
                <div class="relative aspect-[4/3] bg-muted overflow-hidden">
                  {heroUrl ? (
                    <img src={heroUrl} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                  ) : (
                    <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-secondary/10 to-background flex items-center justify-center">
                      <span class="font-display text-5xl text-foreground/30">{p.region?.charAt(0) ?? '·'}</span>
                    </div>
                  )}
                  {total > 0 && (
                    <div class="absolute top-4 right-4 px-3 py-1.5 rounded-full bg-background/85 backdrop-blur-sm text-xs font-mono">
                      {remaining}/{total} lots
                    </div>
                  )}
                </div>
                <div class="p-6 lg:p-8 flex-1 flex flex-col">
                  <p class="text-[11px] uppercase tracking-widest text-muted-foreground mb-2">{p.region}{p.commune ? ` · ${p.commune}` : ''}</p>
                  <h3 class="font-display text-2xl font-bold tracking-tight mb-3">{p.title}</h3>
                  {p.tagline && (
                    <p class="font-serif-italic text-secondary text-sm mb-6">{p.tagline}</p>
                  )}

                  <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm mb-6 pb-6 border-b border-border/40">
                    <div>
                      <dt class="text-[10px] uppercase tracking-widest text-muted-foreground">À partir de</dt>
                      <dd class="font-medium">{p.prix_total ? formatEuro(p.prix_total) : '-'}</dd>
                    </div>
                    <div>
                      <dt class="text-[10px] uppercase tracking-widest text-muted-foreground">Rendement visé</dt>
                      <dd class="font-medium text-primary">{rendementLabel(p.rendement_min, p.rendement_max)}</dd>
                    </div>
                    <div>
                      <dt class="text-[10px] uppercase tracking-widest text-muted-foreground">Livraison</dt>
                      <dd class="font-medium">{p.date_livraison ?? '-'}</dd>
                    </div>
                    {total > 0 && (
                      <div>
                        <dt class="text-[10px] uppercase tracking-widest text-muted-foreground">Avancement</dt>
                        <dd class="flex items-center gap-2 pt-2">
                          <div class="flex-1 h-1 rounded-full bg-muted overflow-hidden">
                            <div class="h-full bg-secondary" style={`width: ${progress}%`}></div>
                          </div>
                        </dd>
                      </div>
                    )}
                  </dl>

                  <div class="mt-auto inline-flex items-center gap-2 text-sm font-medium text-primary group-hover:gap-3 transition-all">
                    Voir l'adresse
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-32 bg-card border-t border-border/60 text-center">
    <div class="container mx-auto px-6 lg:px-8 max-w-3xl">
      <h2 class="font-display text-4xl md:text-5xl font-bold leading-[1.1] tracking-tight mb-6">
        D'autres adresses ouvrent <span class="font-serif-italic text-secondary">en 2027</span>.
      </h2>
      <p class="text-lg text-muted-foreground mb-10">
        Inscrivez-vous pour recevoir en priorité les nouvelles adresses Moodl avant leur ouverture publique.
      </p>
      <a href="/contact" class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-md bg-primary text-primary-foreground font-medium shadow-lg hover:shadow-[0_0_30px_rgba(0,255,128,0.45)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300">
        Être informé en avant-première
      </a>
    </div>
  </section>
</Layout>
