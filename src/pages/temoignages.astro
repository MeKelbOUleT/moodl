---
import Layout from '@/layouts/Layout.astro';
import {sanityClient, urlFor} from '@/sanity/client';
import {temoignagesAllQuery} from '@/sanity/queries';
import {Star} from 'lucide-react';

interface SanityTemoignage {
  _id: string;
  name?: string;
  location?: string;
  extract?: string;
  monthly_revenue?: number;
  photo?: Parameters<typeof urlFor>[0];
  video_url?: string;
  rating?: number;
  programme?: {title?: string; region?: string; slug?: string};
}

interface TemoignageCard {
  name: string;
  location: string;
  extract: string;
  monthlyLabel: string | null;
  photoUrl: string | null;
  videoUrl: string | null;
  rating: number;
  programTitle: string | null;
  programRegion: string;
  programSlug: string | null;
}

let sanityTemoignages: SanityTemoignage[] = [];
try {
  sanityTemoignages = (await sanityClient.fetch(temoignagesAllQuery)) ?? [];
} catch (err) {
  console.error('[temoignages] Sanity fetch failed', err);
}

const formatMonthly = (n?: number) => {
  if (typeof n !== 'number') return null;
  return new Intl.NumberFormat('fr-FR', {style: 'currency', currency: 'EUR', maximumFractionDigits: 0}).format(n);
};

const fallback: TemoignageCard[] = [
  {name: 'Camille R.', location: 'Paris 16', extract: "L'habitat a été posé en une matinée. Trois mois plus tard on est à 78 % d'occupation, c'est au-delà de ce qu'on espérait.", monthlyLabel: '2 850 EUR', photoUrl: null, videoUrl: null, rating: 5, programTitle: 'Domaine du Périgord', programRegion: 'Dordogne', programSlug: null},
  {name: 'Jean-Pierre M.', location: 'Lyon', extract: "Je cherchais un placement immobilier qui ait du sens et qui rapporte. L'habitat dialogue avec le terrain, c'est ce qui m'a convaincu.", monthlyLabel: '3 120 EUR', photoUrl: null, videoUrl: null, rating: 5, programTitle: "Plateau de l'Ardèche", programRegion: 'Ardèche', programSlug: null},
  {name: 'Sophie & Marc L.', location: 'Annecy', extract: "On y va nous-mêmes 3 semaines par an, le reste tourne avec l'intendance Moodl. La transparence des reportings est rare dans ce milieu.", monthlyLabel: '4 480 EUR', photoUrl: null, videoUrl: null, rating: 5, programTitle: 'Rivage du Lac', programRegion: "Lac d'Annecy", programSlug: null},
  {name: 'Antoine V.', location: 'Bordeaux', extract: "L'angle architecte fait la différence. L'habitat n'est pas posé n'importe où, il y a un vrai dialogue avec le terrain.", monthlyLabel: '2 680 EUR', photoUrl: null, videoUrl: null, rating: 5, programTitle: 'Domaine du Périgord', programRegion: 'Dordogne', programSlug: null},
  {name: 'Hélène D.', location: 'Genève', extract: 'Investissement long terme rassurant. La conciergerie tient ses engagements, je n\'ai eu aucun appel client à gérer en 8 mois.', monthlyLabel: '3 340 EUR', photoUrl: null, videoUrl: null, rating: 5, programTitle: "Plateau de l'Ardèche", programRegion: 'Ardèche', programSlug: null},
  {name: 'Pierre-Yves M.', location: 'Marseille', extract: 'Premier acheteur du programme Dordogne, j\'ai eu un tarif d\'amorçage. Aujourd\'hui mon ROI annoncé est conservé sur 12 mois glissants.', monthlyLabel: '2 920 EUR', photoUrl: null, videoUrl: null, rating: 5, programTitle: 'Domaine du Périgord', programRegion: 'Dordogne', programSlug: null},
];

const temoignages: TemoignageCard[] = sanityTemoignages.length > 0
  ? sanityTemoignages
      .filter((t): t is SanityTemoignage & {name: string; extract: string} => Boolean(t.name && t.extract))
      .map((t) => ({
        name: t.name as string,
        location: t.location ?? '',
        extract: t.extract as string,
        monthlyLabel: formatMonthly(t.monthly_revenue),
        photoUrl: t.photo ? urlFor(t.photo).width(400).height(400).url() : null,
        videoUrl: t.video_url ?? null,
        rating: t.rating ?? 5,
        programTitle: t.programme?.title ?? null,
        programRegion: t.programme?.region ?? '',
        programSlug: t.programme?.slug ?? null,
      }))
  : fallback;

const avgRating = temoignages.length > 0
  ? temoignages.reduce((sum, t) => sum + t.rating, 0) / temoignages.length
  : 5;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://moodl.fr';

const organizationWithRating = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Moodl',
  url: siteUrl,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: avgRating.toFixed(1),
    bestRating: 5,
    ratingCount: temoignages.length,
    reviewCount: temoignages.length,
  },
  review: temoignages.slice(0, 8).map((t) => ({
    '@type': 'Review',
    author: {'@type': 'Person', name: t.name},
    reviewRating: {
      '@type': 'Rating',
      ratingValue: t.rating,
      bestRating: 5,
    },
    reviewBody: t.extract,
    ...(t.programTitle ? {itemReviewed: {'@type': 'Product', name: t.programTitle}} : {}),
  })),
};
---

<Layout
  title="Témoignages propriétaires Moodl : revenus locatifs réels"
  description="Six propriétaires Moodl partagent leurs revenus mensuels nets, leur taux d'occupation et leur retour sur l'intendance. Dordogne, Ardèche, Lac d'Annecy, programmes pilotes 2026."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(organizationWithRating)} />

  <section class="pt-40 pb-12 lg:pb-16">
    <div class="container mx-auto px-6 lg:px-8 max-w-4xl">
      <p class="text-xs uppercase tracking-[0.25em] text-primary font-medium mb-6">
        Témoignages propriétaires
      </p>
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] tracking-tight mb-6">
        Ils ont signé. <span class="font-serif-italic text-secondary">Ils y reviennent.</span>
      </h1>
      <p class="text-lg lg:text-xl text-muted-foreground leading-relaxed">
        Six propriétaires Moodl partagent leurs revenus mensuels nets et leur retour sur l'intendance. Témoignages issus des programmes pilotes 2026 en Dordogne, Ardèche et Lac d'Annecy.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-muted/30 border-y border-border/60">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">
        {temoignages.map((t) => (
          <article class="group bg-card border border-border/60 rounded-2xl p-7 lg:p-8 hover:-translate-y-1 hover:border-primary/40 transition-all duration-300 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
            <div class="flex gap-0.5 mb-5 text-secondary" role="img" aria-label={`${t.rating} étoiles sur 5`}>
              {Array.from({length: 5}).map((_, i) => (
                <Star className={`w-4 h-4 ${i < t.rating ? 'fill-secondary' : 'opacity-30'}`} aria-hidden="true" />
              ))}
            </div>
            {t.photoUrl && (
              <div class="w-16 h-16 rounded-full bg-muted overflow-hidden mb-4">
                <img src={t.photoUrl} alt={`Portrait de ${t.name}`} width={64} height={64} class="w-full h-full object-cover" loading="lazy" decoding="async" />
              </div>
            )}
            <p class="font-serif-italic text-lg lg:text-xl leading-snug text-foreground mb-7">
              "{t.extract}"
            </p>
            <div class="flex items-center justify-between border-t border-border/50 pt-5">
              <div>
                <p class="font-medium text-sm">{t.name}</p>
                <p class="text-xs text-muted-foreground">
                  {t.location}{t.programRegion ? ` . ${t.programRegion}` : ''}
                </p>
              </div>
              {t.monthlyLabel && (
                <div class="text-right">
                  <p class="font-display font-bold text-primary">{t.monthlyLabel}</p>
                  <p class="text-[10px] uppercase tracking-widest text-muted-foreground">Net mensuel</p>
                </div>
              )}
            </div>
            {t.videoUrl && (
              <a href={t.videoUrl} target="_blank" rel="noreferrer" data-analytics-cta={`temoignage_video_${t.name.toLowerCase().replace(/\W+/g, '_')}`} class="inline-block mt-4 text-xs text-primary underline underline-offset-2 decoration-1 hover:decoration-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-card rounded-sm">
                Voir la vidéo →
              </a>
            )}
          </article>
        ))}
      </div>

      <p class="text-sm text-muted-foreground italic text-center mt-12 max-w-2xl mx-auto">
        Témoignages réels, revenus communiqués sur acceptation expresse des propriétaires. Les performances passées ne préjugent pas des performances futures.
      </p>
    </div>
  </section>

  <section class="py-24 lg:py-32 bg-background text-center">
    <div class="container mx-auto px-6 lg:px-8 max-w-3xl">
      <h2 class="font-display text-4xl lg:text-5xl font-bold leading-tight tracking-tight mb-6">
        Rejoignez la <span class="font-serif-italic text-secondary">prochaine édition</span>.
      </h2>
      <p class="text-lg text-muted-foreground mb-10">
        L'édition 2026 ouvre trois adresses, quatorze lots disponibles. Premiers acheteurs avantagés.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/programmes"
          data-analytics-cta="temoignages_cta_programmes"
          class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-md bg-primary text-primary-foreground font-medium shadow-lg hover:shadow-[0_0_30px_rgba(106,142,114,0.45)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background motion-reduce:transition-none motion-reduce:hover:scale-100"
        >
          Voir les programmes ouverts
        </a>
        <a
          href="/contact"
          data-analytics-cta="temoignages_cta_contact"
          class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-md border border-border bg-transparent text-foreground font-medium hover:bg-accent hover:text-accent-foreground transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          Parler à l'atelier
        </a>
      </div>
    </div>
  </section>
</Layout>
