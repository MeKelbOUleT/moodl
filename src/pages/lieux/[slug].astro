---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import {sanityClient, urlFor} from '@/sanity/client';
import {lieuxAllQuery, lieuBySlugQuery} from '@/sanity/queries';

export async function getStaticPaths() {
  try {
    const lieux = await sanityClient.fetch(lieuxAllQuery);
    return lieux.map((l: any) => ({params: {slug: l.slug}}));
  } catch {
    return [];
  }
}

const {slug} = Astro.params;
const lieu = await sanityClient.fetch(lieuBySlugQuery, {slug});

if (!lieu) {
  return Astro.redirect('/lieux');
}

const formatEuro = (n: number) =>
  new Intl.NumberFormat('fr-FR', {style: 'currency', currency: 'EUR', maximumFractionDigits: 0}).format(n);

const heroUrl = lieu.hero_image ? urlFor(lieu.hero_image).width(1600).height(900).url() : null;
const galerie = lieu.galerie ?? [];
const surfaceText = lieu.surface_min_m2 && lieu.surface_max_m2 && lieu.surface_min_m2 !== lieu.surface_max_m2
  ? `${lieu.surface_min_m2} à ${lieu.surface_max_m2} m²`
  : `${lieu.surface_max_m2 ?? lieu.surface_min_m2 ?? '-'} m²`;
---

<Layout
  title={lieu.meta_title ?? `${lieu.name} - Moodl`}
  description={lieu.meta_description ?? lieu.subtitle ?? `${lieu.name}, habitat Moodl.`}
  ogImage={heroUrl ?? undefined}
>
  <section class="pt-32 pb-12">
    <div class="container mx-auto px-6 lg:px-8 pt-20">
      <Breadcrumbs
        items={[
          { label: 'Habitats', href: '/lieux' },
          { label: lieu.name },
        ]}
        className="mb-8"
      />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        {heroUrl && (
          <div class="lg:col-span-7">
            <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-muted">
              <img src={heroUrl} alt={lieu.name} class="w-full h-full object-cover" />
            </div>
          </div>
        )}

        <div class={heroUrl ? 'lg:col-span-5' : 'lg:col-span-12'}>
          {lieu.subtitle && (
            <p class="text-xs uppercase tracking-[0.2em] text-primary font-medium mb-4">{lieu.subtitle}</p>
          )}
          <h1 class="font-display text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05] mb-4">
            {lieu.name}
          </h1>
          {lieu.tagline && (
            <p class="font-serif-italic text-2xl text-secondary mb-6">{lieu.tagline}</p>
          )}

          <dl class="grid grid-cols-2 gap-x-6 gap-y-5 mt-8 mb-8 pb-8 border-b border-border/50">
            <div>
              <dt class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Surface</dt>
              <dd class="font-medium">{surfaceText}</dd>
            </div>
            {lieu.capacite && (
              <div>
                <dt class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Capacité</dt>
                <dd class="font-medium">{lieu.capacite}</dd>
              </div>
            )}
            {lieu.loyer_nuit_indicatif && (
              <div>
                <dt class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Loyer indicatif</dt>
                <dd class="font-medium">{lieu.loyer_nuit_indicatif} € / nuit</dd>
              </div>
            )}
            {lieu.prix_a_partir_de && (
              <div>
                <dt class="text-xs uppercase tracking-widest text-muted-foreground mb-1">À partir de</dt>
                <dd class="font-medium">{formatEuro(lieu.prix_a_partir_de)}</dd>
              </div>
            )}
          </dl>

          {lieu.roi_indicatif && (
            <div class="mb-8">
              <p class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Rendement indicatif</p>
              <p class="font-display text-4xl font-bold text-primary">{lieu.roi_indicatif}</p>
            </div>
          )}

          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/programmes" class="flex-1 inline-flex items-center justify-center h-12 px-6 rounded-md bg-primary text-primary-foreground font-medium shadow-lg hover:shadow-[0_0_30px_rgba(106,142,114,0.4)] hover:scale-[1.01] transition-all duration-300">
              Voir les adresses {lieu.name}
            </a>
            <a href="/simulateur" class="inline-flex items-center justify-center h-12 px-6 rounded-md border border-border bg-transparent text-foreground font-medium hover:bg-accent hover:text-accent-foreground hover:scale-[1.01] transition-all">
              Simuler
            </a>
          </div>
        </div>
      </div>

      {lieu.description && (
        <section aria-labelledby="lieu-description" class="max-w-3xl mx-auto mt-20">
          <h2 id="lieu-description" class="font-display text-2xl lg:text-3xl font-bold tracking-tight mb-6">
            Le concept en détail
          </h2>
          <div class="prose prose-invert">
            {lieu.description.map((block: any) => block._type === 'block' && (
              <p class="mb-4 text-muted-foreground leading-relaxed">{block.children?.map((c: any) => c.text).join('')}</p>
            ))}
          </div>
        </section>
      )}

      {galerie.length > 0 && (
        <section aria-labelledby="lieu-galerie" class="mt-20">
          <h2 id="lieu-galerie" class="font-display text-2xl lg:text-3xl font-bold tracking-tight mb-6">
            Galerie
          </h2>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-4">
            {galerie.map((img: any) => (
              <div class="aspect-square rounded-xl overflow-hidden bg-muted">
                <img
                  src={urlFor(img).width(600).height(600).url()}
                  alt={img.alt ?? `${lieu.name}, vue de galerie`}
                  width={600}
                  height={600}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</Layout>
