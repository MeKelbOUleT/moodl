---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import {PortableText} from 'astro-portabletext';
import PTBlock from '@/components/portable/PTBlock.astro';
import PTLink from '@/components/portable/PTLink.astro';
import PTImage from '@/components/portable/PTImage.astro';
import PTCallout from '@/components/portable/PTCallout.astro';
import {sanityClient, urlFor} from '@/sanity/client';
import {articlesAllQuery, articleBySlugQuery} from '@/sanity/queries';

export async function getStaticPaths() {
  try {
    const articles = await sanityClient.fetch(articlesAllQuery);
    return articles.map((a: any) => ({params: {slug: a.slug}}));
  } catch {
    return [];
  }
}

const {slug} = Astro.params;
const article = await sanityClient.fetch(articleBySlugQuery, {slug});

if (!article) {
  return Astro.redirect('/journal');
}

const heroUrl = article.hero_image ? urlFor(article.hero_image).width(1600).height(900).url() : null;
const date = article.published_at ? new Date(article.published_at).toLocaleDateString('fr-FR', {day: 'numeric', month: 'long', year: 'numeric'}) : null;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://moodl.fr';
const authorName = article.author ?? 'Atelier Moodl';
const isHouseAuthor = !article.author || article.author === 'Atelier Moodl';
const authorSchema = isHouseAuthor
  ? {
      '@type': 'Organization',
      name: 'Atelier Moodl',
      url: `${siteUrl}/about`,
    }
  : {
      '@type': 'Person',
      name: authorName,
      url: `${siteUrl}/about`,
      worksFor: {'@type': 'Organization', name: 'Moodl', url: siteUrl},
    };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.excerpt ?? article.meta_description,
  image: heroUrl ? [heroUrl] : undefined,
  author: authorSchema,
  publisher: {
    '@type': 'Organization',
    name: 'Moodl',
    url: siteUrl,
    logo: {'@type': 'ImageObject', url: `${siteUrl}/logo-moodl.png`},
  },
  datePublished: article.published_at,
  dateModified: article._updatedAt ?? article.published_at,
  mainEntityOfPage: {'@type': 'WebPage', '@id': `${siteUrl}/journal/${slug}`},
  inLanguage: 'fr-FR',
};
---

<Layout
  title={article.meta_title ?? `${article.title} - Journal Moodl`}
  description={article.meta_description ?? article.excerpt ?? article.title}
  ogImage={heroUrl ?? undefined}
  ogType="article"
  articlePublishedTime={article.published_at}
  articleModifiedTime={article._updatedAt ?? article.published_at}
  articleAuthor={article.author ?? 'Atelier Moodl'}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  <article>
    <header class="pt-32 pb-12 lg:pb-16">
      <div class="container mx-auto px-6 lg:px-8 max-w-3xl pt-20">
        <Breadcrumbs
          items={[
            { label: 'Journal', href: '/journal' },
            { label: article.title },
          ]}
          className="mb-8"
        />

        {article.eyebrow && (
          <p class="text-xs uppercase tracking-[0.2em] text-primary font-medium mb-4">{article.eyebrow}</p>
        )}
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight mb-6">
          {article.title}
        </h1>
        {article.excerpt && (
          <p class="text-xl text-muted-foreground leading-relaxed mb-8">{article.excerpt}</p>
        )}

        <div class="flex items-center gap-4 text-sm text-muted-foreground">
          {article.author && <span>{article.author}</span>}
          {article.author && date && <span>·</span>}
          {date && <time datetime={article.published_at}>{date}</time>}
          {article.reading_time_min && (
            <>
              <span>·</span>
              <span>{article.reading_time_min} min de lecture</span>
            </>
          )}
        </div>
      </div>
    </header>

    {heroUrl && (
      <div class="container mx-auto px-6 lg:px-8 max-w-5xl mb-12 lg:mb-16">
        <div class="aspect-[16/9] rounded-2xl overflow-hidden bg-muted">
          <img src={heroUrl} alt={article.title} class="w-full h-full object-cover" />
        </div>
      </div>
    )}

    <div class="container mx-auto px-6 lg:px-8 max-w-3xl pb-24">
      <div class="max-w-none">
        {article.body && (
          <PortableText
            value={article.body}
            components={{
              block: PTBlock,
              mark: { link: PTLink },
              type: { image: PTImage, callout: PTCallout },
            }}
          />
        )}
      </div>

      <aside class="mt-16 pt-12 border-t border-border/40" aria-labelledby="article-author">
        <h2 id="article-author" class="sr-only">À propos de l'auteur</h2>
        <div class="flex items-start gap-5 bg-card border border-border/60 rounded-2xl p-6 lg:p-7">
          <div class="w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center shrink-0">
            <span class="font-display text-lg font-bold text-primary">
              {authorName
                .split(' ')
                .map((part: string) => part.charAt(0).toUpperCase())
                .slice(0, 2)
                .join('')}
            </span>
          </div>
          <div class="flex-1">
            <p class="text-[11px] uppercase tracking-widest text-primary font-medium mb-1">Écrit par</p>
            <p class="font-display text-lg lg:text-xl font-bold tracking-tight">{authorName}</p>
            <p class="text-sm text-muted-foreground leading-relaxed mt-1">
              {isHouseAuthor
                ? "L'atelier Moodl conçoit et tient des résidences de tourisme en pleine nature. Architecte, urbaniste et concierge, sous un même toit."
                : `Membre de l'atelier Moodl, qui conçoit et tient des résidences de tourisme en pleine nature.`}
            </p>
            <a
              href="/about"
              class="inline-block mt-3 text-sm text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-card rounded-sm"
            >
              Découvrir l'atelier →
            </a>
          </div>
        </div>
      </aside>

      {article.related_programmes && article.related_programmes.length > 0 && (
        <div class="mt-16 pt-12 border-t border-border/40">
          <h3 class="font-display text-xl font-bold mb-6">Programmes évoqués</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {article.related_programmes.map((p: any) => (
              <a href={`/programmes/${p.slug}`} class="block p-5 bg-card border border-border/60 rounded-xl hover:border-primary/40 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background">
                <p class="text-xs uppercase tracking-widest text-muted-foreground mb-1">{p.region}</p>
                <p class="font-display text-lg font-medium">{p.title}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</Layout>
