---
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import hamletValley from '@/assets/renders/hamlet-valley.jpg';
---

<Layout
  title="Page introuvable — Moodl"
  description="Cette page n'existe pas ou plus. Retrouvez nos adresses, le simulateur ou la conversation avec un expert Moodl."
  noIndex={true}
>
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Background image -->
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
      <Image
        src={hamletValley}
        alt=""
        width={2000}
        height={1200}
        quality={82}
        format="webp"
        loading="eager"
        class="w-full h-full object-cover"
        style="filter: brightness(0.5) saturate(1.1);"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-background/70 via-background/60 to-background"></div>
      <div class="absolute inset-0" style="background: radial-gradient(ellipse 60% 50% at 50% 50%, hsl(135 18% 50% / 0.08), transparent 65%);"></div>
    </div>

    <div class="container mx-auto px-6 lg:px-8 relative">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-xs uppercase tracking-[0.3em] text-primary font-medium mb-6">
          Erreur 404
        </p>

        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] tracking-tight mb-8">
          Cette page s'est{' '}
          <span class="font-serif-italic text-secondary">perdue en forêt</span>.
        </h1>

        <p class="text-lg lg:text-xl text-muted-foreground leading-relaxed mb-10 max-w-xl mx-auto">
          Le sentier que vous suiviez n'existe plus, ou bien il n'a jamais existé. Pas grave — l'atelier vous indique le chemin.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
          <a
            href="/"
            class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-md bg-primary text-primary-foreground font-medium shadow-lg hover:shadow-[0_0_30px_rgba(106,142,114,0.45)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Retour à l'accueil
          </a>
          <a
            href="/programmes"
            class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-md border border-border bg-transparent text-foreground font-medium hover:bg-accent hover:text-accent-foreground hover:scale-[1.02] active:scale-[0.98] transition-all duration-300"
          >
            Voir les adresses
          </a>
        </div>

        <div class="pt-10 border-t border-border/40 max-w-md mx-auto">
          <p class="text-xs uppercase tracking-[0.25em] text-muted-foreground mb-4">
            Ou peut-être cherchiez-vous
          </p>
          <ul class="grid grid-cols-2 gap-2 text-sm">
            <li>
              <a href="/lieux" class="block py-2 text-foreground/80 hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded">
                Les habitats Moodl →
              </a>
            </li>
            <li>
              <a href="/simulateur" class="block py-2 text-foreground/80 hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded">
                Simuler la rentabilité →
              </a>
            </li>
            <li>
              <a href="/journal" class="block py-2 text-foreground/80 hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded">
                Le Journal →
              </a>
            </li>
            <li>
              <a href="/contact" class="block py-2 text-foreground/80 hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded">
                Parler à l'atelier →
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
